# Canonical site URL. Optional on Netlify: the build uses Netlify's primary
# domain automatically (and switches when you attach a custom domain).
PUBLIC_SITE_URL=

# Amazon Associates tracking ID — MUST be your own (Associates Central → Tracking IDs).
AMAZON_ASSOCIATE_TAG=homespaguide-20

# Search engine verification (paste only the content="..." value)
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
PUBLIC_PINTEREST_VERIFICATION=

# Analytics — pick one (all optional)
PUBLIC_CLOUDFLARE_BEACON_TOKEN=
PUBLIC_GA4_ID=
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SCRIPT=

# Google AdSense — leave empty until approved (ca-pub-XXXXXXXXXXXXXXXX)
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_INARTICLE=
PUBLIC_ADSENSE_SLOT_SIDEBAR=

# Future PA-API integration (only after Amazon grants access):
# AMAZON_PA_API_ACCESS_KEY=
# AMAZON_PA_API_SECRET_KEY=
# AMAZON_PA_API_PARTNER_TAG=
