---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/inter';
import newsreaderWoff2 from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/globals.css';
import SEO from '../components/seo/SEO.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SearchOverlay from '../components/layout/SearchOverlay.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}

const props = Astro.props;
const env = import.meta.env;
const siteUrl = env.SITE;
const abs = (p: string) => new URL(p, siteUrl).toString();

// Site-wide entity graph. Page-level schema (Product, Article, FAQPage,
// BreadcrumbList) references these nodes by @id.
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': abs('/#organization'),
      name: 'HomeSpaGuide',
      url: abs('/'),
      logo: { '@type': 'ImageObject', url: abs('/logo-512.png'), width: 512, height: 512 },
      description:
        'Independent editorial guide to home spas, inflatable and hard-shell hot tubs, water care chemicals, filters and accessories.',
      publishingPrinciples: abs('/editorial-policy'),
      sameAs: [],
    },
    {
      '@type': 'WebSite',
      '@id': abs('/#website'),
      url: abs('/'),
      name: 'HomeSpaGuide',
      inLanguage: 'en-US',
      publisher: { '@id': abs('/#organization') },
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: abs('/search') + '?q={search_term_string}' },
        'query-input': 'required name=search_term_string',
      },
    },
  ],
};

const ga4 = env.PUBLIC_GA4_ID;
const cfBeacon = env.PUBLIC_CLOUDFLARE_BEACON_TOKEN;
const adsense = env.PUBLIC_ADSENSE_CLIENT;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <link rel="preload" href={newsreaderWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="HomeSpaGuide" href="/rss.xml" />
    <SEO {...props} />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    {env.PUBLIC_PLAUSIBLE_DOMAIN && env.PUBLIC_PLAUSIBLE_SCRIPT && (
      <script is:inline defer data-domain={env.PUBLIC_PLAUSIBLE_DOMAIN} src={env.PUBLIC_PLAUSIBLE_SCRIPT} />
    )}
    {cfBeacon && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfBeacon })}
      />
    )}
    {ga4 && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`} />
        <script is:inline define:vars={{ ga4 }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', ga4, { anonymize_ip: true });
        </script>
      </>
    )}
    {adsense && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsense}`}
        crossorigin="anonymous"
      />
    )}
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" data-pagefind-body>
      <slot />
    </main>
    <Footer />
    <SearchOverlay />
    <slot name="end" />
    <script>
      // Outbound Amazon click tracking — works with whichever analytics is
      // configured (Plausible custom event / GA4 event); no-op otherwise.
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-amazon-cta], a[href*="amazon.com/"]');
        if (!a) return;
        const props = {
          asin: a.dataset.asin || '',
          placement: a.dataset.placement || '',
          page: location.pathname,
        };
        const w = window as any;
        try { w.plausible?.('Amazon Click', { props }); } catch {}
        try { w.gtag?.('event', 'amazon_click', props); } catch {}
      });
    </script>
  </body>
</html>
