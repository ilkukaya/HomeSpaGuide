---
import { getEntry, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import TOC from '../components/blog/TOC.astro';
import ArticleSchema from '../components/seo/ArticleSchema.astro';
import FAQSchema from '../components/seo/FAQSchema.astro';
import QuickAnswer from '../components/article/QuickAnswer.astro';
import AuthorBox from '../components/article/AuthorBox.astro';
import RelatedArticles from '../components/article/RelatedArticles.astro';
import FaqList from '../components/ui/FaqList.astro';
import ProductCard from '../components/product/ProductCard.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import ProductMiniList from '../components/product/ProductMiniList.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
}

const { post, headings } = Astro.props;
const p = post.data;
const siteUrl = import.meta.env.SITE;
const href = `/blog/${post.slug}`;
const url = new URL(href, siteUrl).toString();
const ogPath = `/og/blog/${post.slug}.png`;
const updated = p.updatedAt ?? p.publishedAt;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const faqs = p.faqs ?? [];
const words = (post.body ?? '').split(/\s+/).length;
const readMins = Math.max(2, Math.round(words / 230));

const products = (
  await Promise.all((p.featuredProducts ?? []).map((r) => getEntry('products', r.id)))
).filter((x): x is CollectionEntry<'products'> => Boolean(x));
const picksFirst = ['buying-guide', 'comparison', 'reviews'].includes(p.category);
const tocHeadings = [...headings, ...(faqs.length ? [{ depth: 2, slug: 'faq', text: 'FAQ' }] : [])];
---

<BaseLayout
  title={p.seo?.metaTitle ?? p.title}
  description={p.seo?.metaDescription ?? p.excerpt}
  ogType="article"
  ogImage={ogPath}
  ogImageAlt={p.title}
  publishedTime={p.publishedAt.toISOString()}
  modifiedTime={updated.toISOString()}
>
  <article class="container-page article">
    <Breadcrumbs items={[{ label: 'Advice', href: '/blog' }, { label: p.title }]} />
    <header class="article__header">
      <p class="article__kicker">{p.category.replace(/-/g, ' ')}</p>
      <h1>{p.title}</h1>
      <p class="article__dek">{p.excerpt}</p>
      <p class="article__meta">
        <span>By <a href="/about">HomeSpaGuide Editors</a></span>
        <span aria-hidden="true">·</span>
        <span>Updated <time datetime={updated.toISOString()}>{fmt(updated)}</time></span>
        <span aria-hidden="true">·</span>
        <span>{readMins} min read</span>
      </p>
      <p class="article__disclosure">
        We may earn a commission when you buy through links on this page. <a href="/affiliate-disclosure">How we make money</a>.
      </p>
    </header>

    <div class="article__layout">
      <div class="article__main">
        <QuickAnswer answer={p.quickAnswer} takeaways={p.keyTakeaways} />

        {picksFirst && products.length > 0 && (
          <section class="article__picks" aria-labelledby="picks-title">
            <h2 id="picks-title">Our picks at a glance</h2>
            <div class="article__picks-grid">
              {products.map((prod, i) => <ProductCard product={prod} campaign={`blog-${post.slug}`} rank={i + 1} />)}
            </div>
          </section>
        )}

        {!picksFirst && (
          <ProductMiniList products={products} heading="What you’ll need" campaign={`blog-${post.slug}`} />
        )}

        <div class="prose article__body">
          <slot />
        </div>

        <AdSlot slot={import.meta.env.PUBLIC_ADSENSE_SLOT_INARTICLE} format="in-article" />

        {faqs.length > 0 && (
          <section class="article__faq" id="faq">
            <h2>Frequently asked questions</h2>
            <FaqList faqs={faqs} />
          </section>
        )}

        <AuthorBox />
      </div>

      <aside class="article__aside">
        <div class="article__aside-sticky">
          <TOC headings={tocHeadings} />
          <AdSlot slot={import.meta.env.PUBLIC_ADSENSE_SLOT_SIDEBAR} class="article__aside-ad" />
        </div>
      </aside>
    </div>

    <RelatedArticles currentHref={href} tags={p.tags} />
  </article>

  <ArticleSchema
    slot="head"
    type="BlogPosting"
    title={p.title}
    description={p.excerpt}
    url={url}
    imageUrl={new URL(ogPath, siteUrl).toString()}
    publishedAt={p.publishedAt}
    updatedAt={p.updatedAt}
    keywords={p.tags}
  />
  {faqs.length > 0 && <FAQSchema slot="head" faqs={faqs} />}
</BaseLayout>

<style>
  .article { padding-top: 1.25rem; padding-bottom: 2rem; display: flex; flex-direction: column; gap: 2.5rem; }
  .article__header { max-width: 760px; }
  .article__kicker { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; color: var(--color-cedar); margin: 1.25rem 0 0.75rem; }
  .article__header h1 { font-size: clamp(2rem, 1.4rem + 2.6vw, 3.2rem); letter-spacing: -0.028em; line-height: 1.06; }
  .article__dek { margin-top: 1rem; font-size: clamp(1.08rem, 1rem + 0.35vw, 1.25rem); line-height: 1.55; color: var(--color-ink-muted); }
  .article__meta { margin-top: 1.1rem; display: flex; flex-wrap: wrap; gap: 0.45rem; font-size: 0.875rem; color: var(--color-ink-muted); }
  .article__meta a { color: var(--color-ink); font-weight: 600; }
  .article__disclosure { margin-top: 0.6rem; font-size: 0.8rem; color: var(--color-ink-subtle); }
  .article__disclosure a { text-decoration: underline; text-underline-offset: 2px; }

  .article__layout { display: grid; gap: 2rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1000px) { .article__layout { grid-template-columns: minmax(0, 1fr) 280px; gap: 4rem; } }
  .article__main { display: flex; flex-direction: column; gap: 2.25rem; min-width: 0; }
  .article__aside { order: -1; }
  @media (min-width: 1000px) {
    .article__aside { order: 0; }
    .article__aside-sticky { position: sticky; top: calc(var(--header-height) + 1.5rem); display: flex; flex-direction: column; gap: 1.5rem; }
  }
  .article__aside-ad { display: none; }
  @media (min-width: 1000px) { .article__aside-ad { display: flex; } }
  .article__body { max-width: 70ch; }
  .article__picks h2, .article__faq h2 { font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.9rem); margin-bottom: 1rem; }
  .article__picks-grid { display: grid; gap: 1rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px) { .article__picks-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .article__picks-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .article__faq { scroll-margin-top: calc(var(--header-height) + 1rem); max-width: 70ch; }
</style>
