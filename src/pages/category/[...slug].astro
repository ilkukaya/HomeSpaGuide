---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import CategoryHero from '../../components/catalog/CategoryHero.astro';
import ProductCard from '../../components/product/ProductCard.astro';
import FilterSidebar, { type FilterFacets } from '../../components/catalog/FilterSidebar';
import SortDropdown from '../../components/catalog/SortDropdown';
import AffiliateDisclosure from '../../components/layout/AffiliateDisclosure.astro';
import ItemListSchema from '../../components/seo/ItemListSchema.astro';
import { PRICE_RANGES } from '../../lib/prices';

export async function getStaticPaths() {
  const cats = await getCollection('categories');
  return cats.map((c) => ({
    params: { slug: c.slug },
    props: { category: c },
  }));
}

const { category } = Astro.props;
const c = category.data;

const allCats = await getCollection('categories');

// Build a slug index so we can normalize across Astro's entry.id /
// entry.slug / reference.id variations and traverse the parent tree.
const catBySlug = new Map(allCats.map((c) => [c.slug, c]));
const catById = new Map(allCats.map((c) => [c.id, c]));
const slugOf = (ref: { id: string }) =>
  catById.get(ref.id)?.slug ?? catBySlug.get(ref.id)?.slug ?? ref.id;

const descendants = new Set<string>([category.slug]);
let frontier = [category.slug];
while (frontier.length) {
  const next: string[] = [];
  for (const slug of frontier) {
    for (const cat of allCats) {
      if (!cat.data.parent) continue;
      const parentSlug = slugOf(cat.data.parent);
      if (parentSlug === slug && !descendants.has(cat.slug)) {
        descendants.add(cat.slug);
        next.push(cat.slug);
      }
    }
  }
  frontier = next;
}

const allProducts = await getCollection('products', ({ data }) => data.status === 'active');
const products = allProducts.filter((p) => descendants.has(slugOf(p.data.category)));

const brandIds = Array.from(new Set(products.map((p) => p.data.brand.id)));
const brandEntries = await Promise.all(brandIds.map((id) => getEntry('brands', id)));
const brands = brandEntries
  .filter((b): b is NonNullable<typeof b> => Boolean(b))
  .map((b) => ({ id: b.id, name: b.data.name }));

const usedPriceRanges = Array.from(new Set(products.map((p) => p.data.priceRange)));
const facets: FilterFacets = {
  brands,
  priceRanges: usedPriceRanges.map((r) => ({ value: r, label: PRICE_RANGES[r].label })),
  setupTypes: Array.from(new Set(products.map((p) => p.data.specs.setupType).filter((x): x is NonNullable<typeof x> => Boolean(x)))),
  indoorOutdoor: Array.from(new Set(products.map((p) => p.data.specs.indoorOutdoor).filter((x): x is NonNullable<typeof x> => Boolean(x)))),
  badges: Array.from(new Set(products.flatMap((p) => p.data.editorBadges))),
};

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://homespaguide.com';
const itemListItems = products.slice(0, 20).map((p) => ({
  name: p.data.title,
  url: new URL(`/products/${p.slug}`, siteUrl).toString(),
}));

const { Content } = await category.render();
---

<BaseLayout
  title={`${c.name} — HomeSpaGuide`}
  description={c.shortDescription}
>
  <div class="container-page">
    <Breadcrumbs items={[{ label: c.name }]} />
    <CategoryHero category={category} />

    <div class="catalog">
      <FilterSidebar client:load facets={facets} />
      <div class="catalog__main">
        <div class="catalog__toolbar">
          <p class="catalog__count" data-result-count>{products.length} products</p>
          <SortDropdown client:load defaultValue="featured" />
        </div>
        <div class="catalog__grid" data-product-grid>
          {products.map((p) => (
            <article
              class="catalog__card"
              data-card
              data-brand={p.data.brand.id}
              data-price={p.data.priceRange}
              data-setup={p.data.specs.setupType ?? ''}
              data-placement={p.data.specs.indoorOutdoor ?? ''}
              data-badges={p.data.editorBadges.join(',')}
              data-score={p.data.editorScore.overall}
              data-pick={p.data.editorPick ? '1' : '0'}
              data-price-min={PRICE_RANGES[p.data.priceRange].min}
              data-price-max={PRICE_RANGES[p.data.priceRange].max}
              data-published={(+p.data.publishedAt)}
              data-name={p.data.shortTitle}
            >
              <ProductCard product={p} campaign="category" />
            </article>
          ))}
        </div>
        <p data-empty hidden class="catalog__empty">No products match your filters. <button type="button" data-clear-filters>Clear all</button>.</p>
      </div>
    </div>

    <section class="catalog__about prose">
      <h2>About {c.name}</h2>
      <Content />
      {c.faqs && c.faqs.length > 0 && (
        <>
          <h3>Frequently asked questions</h3>
          {c.faqs.map((f) => (
            <details class="catalog__faq">
              <summary>{f.question}</summary>
              <p>{f.answer}</p>
            </details>
          ))}
        </>
      )}
    </section>

    <AffiliateDisclosure variant="banner" />
  </div>

  <ItemListSchema slot="head" items={itemListItems} />
</BaseLayout>

<style is:global>
  .hsg-filter {
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    padding: 1.25rem 1.4rem;
    font-size: 0.9rem;
    box-shadow: var(--shadow-card);
  }
  .hsg-filter__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .hsg-filter__head h2 {
    font-size: var(--text-xs);
    font-family: var(--font-sans);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    color: var(--color-cedar);
    margin: 0;
  }
  .hsg-filter__clear {
    font-size: 0.8rem;
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-cedar-soft);
    text-underline-offset: 3px;
  }
  .hsg-filter fieldset {
    border: none;
    padding: 0 0 1rem;
    margin: 0 0 1rem;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .hsg-filter fieldset:last-child { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }
  .hsg-filter legend {
    font-weight: 600;
    color: var(--color-primary-900);
    margin-bottom: 0.5rem;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
  }
  .hsg-filter label {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    color: var(--color-ink-muted);
    cursor: pointer;
    padding: 0.15rem 0;
    transition: color var(--dur-base) var(--ease-out);
  }
  .hsg-filter label:hover { color: var(--color-primary); }
  .hsg-filter input[type='checkbox'] { accent-color: var(--color-primary); }
  .hsg-filter input[type='range'] { accent-color: var(--color-primary); width: 100%; }

  .hsg-filter__mobile-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-ink);
    font-weight: 600;
  }
  .hsg-filter__drawer {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: rgba(15, 30, 32, 0.55);
    animation: hsg-fade-in var(--dur-base) var(--ease-out);
  }
  @keyframes hsg-fade-in { from { opacity: 0; } to { opacity: 1; } }
  .hsg-filter__drawer-inner {
    background: var(--color-paper);
    height: 100%;
    width: min(90%, 360px);
    overflow-y: auto;
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    animation: hsg-slide-in var(--dur-slow) var(--ease-out);
  }
  @keyframes hsg-slide-in { from { transform: translateX(-16px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
  .hsg-filter__drawer-close {
    padding: 0.85rem 1.25rem;
    background: var(--color-primary);
    color: var(--color-ink-on-dark);
    border-radius: var(--radius-md);
    font-weight: 600;
    margin-top: auto;
  }
  @media (min-width: 900px) {
    .hsg-filter__mobile-toggle { display: none; }
    .hsg-filter__drawer { display: none; }
  }
  @media (max-width: 899px) { .hsg-filter { display: none; } }

  .hsg-sort { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; color: var(--color-ink-muted); }
  .hsg-sort__select {
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-size: 0.9rem;
    color: var(--color-ink);
  }
</style>

<style>
  .catalog { display: grid; gap: 1.5rem; grid-template-columns: 1fr; margin-top: 1rem; }
  @media (min-width: 900px) { .catalog { grid-template-columns: 240px 1fr; align-items: flex-start; } }
  .catalog__toolbar { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .catalog__count { color: var(--color-ink-subtle); font-size: 0.9rem; margin: 0; }
  .catalog__grid { display: grid; gap: 1.25rem; grid-template-columns: 1fr; }
  @media (min-width: 600px) { .catalog__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) { .catalog__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1200px) { .catalog__grid { grid-template-columns: repeat(3, 1fr); } }
  .catalog__empty {
    padding: 2.5rem 1.5rem;
    text-align: center;
    color: var(--color-ink-muted);
    background: var(--color-steam);
    border-radius: var(--radius-xl);
  }
  .catalog__empty button { color: var(--color-primary); text-decoration: underline; text-decoration-color: var(--color-cedar-soft); }
  .catalog__about { margin: 3rem 0; }
  .catalog__about h2 { margin-bottom: 0.75rem; }
  .catalog__faq {
    margin: 0.5rem 0;
    padding: 0.85rem 1.1rem;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);
  }
  .catalog__faq summary { cursor: pointer; font-weight: 600; color: var(--color-primary); font-family: var(--font-serif); }
  .catalog__faq p { margin-top: 0.5rem; color: var(--color-ink-muted); }
</style>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
  const grid = document.querySelector<HTMLElement>('[data-product-grid]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const count = document.querySelector<HTMLElement>('[data-result-count]');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-clear-filters]');

  function readParams() {
    const p = new URLSearchParams(window.location.search);
    const list = (k: string) => (p.get(k) ? p.get(k)!.split(',').filter(Boolean) : []);
    return {
      brand: list('brand'),
      price: list('price'),
      setup: list('setup'),
      placement: list('placement'),
      badge: list('badge'),
      score: Number(p.get('score') || 0),
      pick: p.get('pick') === '1',
      sort: p.get('sort') || 'featured',
    };
  }

  function matches(card: HTMLElement, s: ReturnType<typeof readParams>): boolean {
    if (s.brand.length && !s.brand.includes(card.dataset.brand || '')) return false;
    if (s.price.length && !s.price.includes(card.dataset.price || '')) return false;
    if (s.setup.length && !s.setup.includes(card.dataset.setup || '')) return false;
    if (s.placement.length && !s.placement.includes(card.dataset.placement || '')) return false;
    if (s.badge.length) {
      const cardBadges = (card.dataset.badges || '').split(',');
      if (!s.badge.some((b) => cardBadges.includes(b))) return false;
    }
    if (s.score > 0 && Number(card.dataset.score) < s.score) return false;
    if (s.pick && card.dataset.pick !== '1') return false;
    return true;
  }

  function compareForSort(a: HTMLElement, b: HTMLElement, sort: string): number {
    switch (sort) {
      case 'score-desc': return Number(b.dataset.score) - Number(a.dataset.score);
      case 'price-asc': return Number(a.dataset.priceMin) - Number(b.dataset.priceMin);
      case 'price-desc': return Number(b.dataset.priceMax) - Number(a.dataset.priceMax);
      case 'newest': return Number(b.dataset.published) - Number(a.dataset.published);
      case 'name-asc': return (a.dataset.name || '').localeCompare(b.dataset.name || '');
      default:
        const pa = a.dataset.pick === '1' ? 1 : 0;
        const pb = b.dataset.pick === '1' ? 1 : 0;
        if (pa !== pb) return pb - pa;
        return Number(b.dataset.score) - Number(a.dataset.score);
    }
  }

  function apply() {
    const state = readParams();
    let shown = 0;
    const matching = cards.filter((c) => matches(c, state));
    matching.sort((a, b) => compareForSort(a, b, state.sort));
    // hide all then re-append in order
    cards.forEach((c) => (c.style.display = 'none'));
    matching.forEach((c) => {
      c.style.display = '';
      grid?.appendChild(c);
      shown++;
    });
    if (count) count.textContent = `${shown} product${shown === 1 ? '' : 's'}`;
    if (empty) empty.hidden = shown !== 0;
  }

  apply();
  window.addEventListener('hsg:filter:change', apply);
  window.addEventListener('hsg:sort:change', apply);
  window.addEventListener('popstate', apply);
  clearBtn?.addEventListener('click', () => {
    window.history.replaceState({}, '', window.location.pathname);
    window.dispatchEvent(new CustomEvent('hsg:filter:change'));
  });
</script>
