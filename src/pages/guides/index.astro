---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';

const guides = (await getCollection('guides')).sort((a, b) => +b.data.updatedAt - +a.data.updatedAt);
---

<BaseLayout title="Hot Tub Buying Guides & Owner Handbooks" description="Step-by-step guides to choosing, placing and looking after a home hot tub: first-spa buying advice, chemicals for beginners, filter cleaning and water care.">
  <div class="container-page" style="padding-top: 1.5rem; padding-bottom: 4rem;">
    <Breadcrumbs items={[{ label: 'Guides' }]} />
    <header style="margin: 1.5rem 0 2rem; max-width: 60ch;">
      <h1 style="font-size: clamp(2.2rem, 1.6rem + 2.6vw, 3.4rem); letter-spacing: -0.03em;">Guides</h1>
      <p style="color: var(--color-ink-muted); font-size: 1.1rem; margin-top: 0.75rem;">Longer, step-by-step handbooks: choosing your first spa, where to put it, and the routines that keep the water clear.</p>
    </header>
    {guides.length > 0 ? (
      <ul class="guide-list">
        {guides.map((g) => (
          <li>
            <a href={`/guides/${g.slug}`} class="guide-list__card">
              <span class="eyebrow">{g.data.topic}</span>
              <h2>{g.data.title}</h2>
              <p>{g.data.quickAnswer ?? g.data.intro}</p>
              <span class="guide-list__cta">Read the guide <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p style="color: var(--color-ink-subtle);">No guides published yet.</p>
    )}
  </div>
</BaseLayout>

<style>
  .guide-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
  }
  .guide-list__card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--color-primary);
    border-radius: var(--radius-lg);
    color: var(--color-ink);
    height: 100%;
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .guide-list__card:hover { border-color: var(--color-primary); }
  .guide-list__card h2 { font-size: 1.45rem; font-weight: 550; line-height: 1.2; margin: 0.4rem 0 0.25rem; }
  .guide-list__card p { color: var(--color-ink-muted); font-size: 0.95rem; line-height: var(--leading-normal); flex: 1; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .guide-list__cta { color: var(--color-primary); font-weight: 600; font-size: 0.9rem; margin-top: 0.5rem; display: inline-flex; align-items: center; gap: 0.3rem; }
</style>
