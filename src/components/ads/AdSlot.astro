---
/**
 * Google AdSense display unit. Renders nothing until both the publisher ID
 * (PUBLIC_ADSENSE_CLIENT) and the unit's slot ID are configured, so the site
 * stays ad-free (and fast) until AdSense approves it. Space is reserved to
 * avoid layout shift (CLS) once ads are live.
 */
interface Props {
  slot?: string;
  format?: 'in-article' | 'auto';
  class?: string;
}
const { slot, format = 'auto', class: className = '' } = Astro.props;
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
---

{client && slot && (
  <div class:list={['ad-slot', className]} data-pagefind-ignore>
    <span class="ad-slot__label">Advertisement</span>
    {format === 'in-article' ? (
      <ins class="adsbygoogle" style="display:block; text-align:center;" data-ad-layout="in-article" data-ad-format="fluid" data-ad-client={client} data-ad-slot={slot}></ins>
    ) : (
      <ins class="adsbygoogle" style="display:block" data-ad-client={client} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
    )}
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}

<style>
  .ad-slot { min-height: 280px; margin: 2rem 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .ad-slot__label { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-ink-subtle); }
</style>
