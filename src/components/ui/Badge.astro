---
import { cn } from '../../lib/cn';

type Variant =
  | 'default'
  | 'editor-pick'
  | 'best-seller'
  | 'best-value'
  | 'new'
  | 'top-rated'
  | 'budget-pick'
  | 'premium-pick'
  | 'price';

interface Props {
  variant?: Variant;
  class?: string;
}

const { variant = 'default', class: className } = Astro.props;

const variants: Record<Variant, string> = {
  default: 'bg-[var(--color-surface)] text-[var(--color-ink-muted)] ring-1 ring-[var(--color-border-strong)]',
  'editor-pick': 'bg-[var(--color-primary)] text-[var(--color-ink-on-dark)] ring-1 ring-[var(--color-primary)]',
  'best-seller': 'bg-[var(--color-surface)] text-[var(--color-ink)] ring-1 ring-[var(--color-border-strong)]',
  'best-value': 'bg-[var(--color-surface)] text-[var(--color-success)] ring-1 ring-[#9CC9AE]',
  new: 'bg-[var(--color-surface)] text-[var(--color-primary-700)] ring-1 ring-[var(--color-primary-200)]',
  'top-rated': 'bg-[var(--color-surface)] text-[var(--color-primary-700)] ring-1 ring-[var(--color-primary-200)]',
  'budget-pick': 'bg-[var(--color-surface)] text-[var(--color-cedar-deep)] ring-1 ring-[var(--color-cedar-soft)]',
  'premium-pick': 'bg-[var(--color-ink)] text-[var(--color-ink-on-dark)] ring-1 ring-[var(--color-ink)]',
  price: 'bg-[var(--color-surface)] text-[var(--color-primary)] ring-1 ring-[var(--color-primary-200)]',
};
---

<span class={cn('inline-flex items-center gap-1 px-2 py-[3px] rounded-[3px] text-[10.5px] leading-none font-semibold uppercase tracking-[0.07em]', variants[variant], className)}>
  <slot />
</span>
