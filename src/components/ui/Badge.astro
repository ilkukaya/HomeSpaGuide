---
import { cn } from '../../lib/cn';

type Variant =
  | 'default'
  | 'editor-pick'
  | 'best-seller'
  | 'best-value'
  | 'new'
  | 'top-rated'
  | 'budget-pick'
  | 'premium-pick'
  | 'price';

interface Props {
  variant?: Variant;
  class?: string;
}

const { variant = 'default', class: className } = Astro.props;

const variants: Record<Variant, string> = {
  default: 'bg-[var(--color-paper-deep)] text-[var(--color-ink-muted)] ring-1 ring-[var(--color-border)]',
  'editor-pick': 'bg-[var(--color-cedar-soft)] text-[var(--color-cedar-deep)] ring-1 ring-[var(--color-cedar)]',
  'best-seller': 'bg-[var(--color-amber-soft)] text-[#7a4a0b] ring-1 ring-[var(--color-amber)]',
  'best-value': 'bg-[var(--color-success-soft)] text-[var(--color-success)] ring-1 ring-[var(--color-success)]',
  new: 'bg-[var(--color-steam)] text-[var(--color-primary-700)] ring-1 ring-[var(--color-primary-200)]',
  'top-rated': 'bg-[var(--color-primary-100)] text-[var(--color-primary-700)] ring-1 ring-[var(--color-primary-200)]',
  'budget-pick': 'bg-[var(--color-warning-soft)] text-[var(--color-warning)] ring-1 ring-[var(--color-warning)]',
  'premium-pick': 'bg-[var(--color-primary-900)] text-[var(--color-amber)] ring-1 ring-[var(--color-primary-700)]',
  price: 'bg-[var(--color-surface)] text-[var(--color-primary)] ring-1 ring-[var(--color-primary-200)]',
};
---

<span class={cn('inline-flex items-center gap-1 px-2.5 py-1 rounded-[var(--radius-full)] text-[11px] font-semibold uppercase tracking-[var(--tracking-meta)]', variants[variant], className)}>
  <slot />
</span>
