---
import { cn } from '../../lib/cn';

type Variant = 'primary' | 'secondary' | 'ghost' | 'amazon' | 'outline';
type Size = 'sm' | 'md' | 'lg';
type Tag = 'a' | 'button';

interface Props {
  variant?: Variant;
  size?: Size;
  as?: Tag;
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  rel?: string;
  target?: string;
  ariaLabel?: string;
  fullWidth?: boolean;
  disabled?: boolean;
}

const {
  variant = 'primary',
  size = 'md',
  as,
  href,
  type = 'button',
  class: className,
  rel,
  target,
  ariaLabel,
  fullWidth = false,
  disabled,
} = Astro.props;

const Tag = (as ?? (href ? 'a' : 'button')) as Tag;

const base = 'inline-flex items-center justify-center gap-2 font-semibold rounded-[var(--radius-md)] transition-colors duration-200 ease-out select-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary)] disabled:opacity-60 disabled:cursor-not-allowed';
const sizes: Record<Size, string> = {
  sm: 'px-3 py-1.5 text-sm',
  md: 'px-5 py-3 text-base',
  lg: 'px-6 py-3.5 text-lg',
};
const variants: Record<Variant, string> = {
  primary: 'btn-variant-primary',
  secondary: 'btn-variant-secondary',
  ghost: 'btn-variant-ghost',
  outline: 'btn-variant-outline',
  amazon: 'btn-variant-amazon',
};

const sizeKey = size as Size;
const variantKey = variant as Variant;
const classes = cn(base, sizes[sizeKey], variants[variantKey], fullWidth && 'w-full', className);
---

{Tag === 'a' ? (
  <a href={href} rel={rel} target={target} aria-label={ariaLabel} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} aria-label={ariaLabel} disabled={disabled} class={classes}>
    <slot />
  </button>
)}

<style is:global>
  .btn-variant-primary {
    background: var(--color-primary);
    color: var(--color-ink-on-dark);
  }
  .btn-variant-primary:hover { background: var(--color-primary-600); color: var(--color-ink-on-dark); }
  .btn-variant-primary:active { background: var(--color-primary-700); }

  .btn-variant-secondary {
    background: var(--color-paper-deep);
    color: var(--color-ink);
  }
  .btn-variant-secondary:hover { background: var(--color-cedar-soft); color: var(--color-cedar-deep); }

  .btn-variant-ghost {
    background: transparent;
    color: var(--color-ink-muted);
  }
  .btn-variant-ghost:hover { background: var(--color-paper-deep); color: var(--color-primary); }

  .btn-variant-outline {
    background: transparent;
    color: var(--color-primary);
    border: 1px solid var(--color-border-strong);
  }
  .btn-variant-outline:hover { background: var(--color-primary-50); border-color: var(--color-primary); color: var(--color-primary); }

  .btn-variant-amazon {
    background: var(--color-amazon);
    color: var(--color-amazon-ink);
    font-weight: 700;
    box-shadow: var(--shadow-sm);
  }
  .btn-variant-amazon:hover { background: var(--color-amazon-hover); color: var(--color-amazon-ink); box-shadow: var(--shadow-md); }
</style>
