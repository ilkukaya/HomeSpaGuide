---
import { cn } from '../../lib/cn';

type Variant = 'primary' | 'secondary' | 'ghost' | 'amazon' | 'outline';
type Size = 'sm' | 'md' | 'lg';
type Tag = 'a' | 'button';

interface Props {
  variant?: Variant;
  size?: Size;
  as?: Tag;
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  rel?: string;
  target?: string;
  ariaLabel?: string;
  fullWidth?: boolean;
  disabled?: boolean;
}

const {
  variant = 'primary',
  size = 'md',
  as,
  href,
  type = 'button',
  class: className,
  rel,
  target,
  ariaLabel,
  fullWidth = false,
  disabled,
} = Astro.props;

const Tag = (as ?? (href ? 'a' : 'button')) as Tag;

const base = 'inline-flex items-center justify-center gap-2 font-medium rounded-[var(--radius-md)] transition-all duration-150 select-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary)] disabled:opacity-60 disabled:cursor-not-allowed';
const sizes: Record<Size, string> = {
  sm: 'px-3 py-1.5 text-sm',
  md: 'px-4 py-2.5 text-base',
  lg: 'px-6 py-3.5 text-lg',
};
const variants: Record<Variant, string> = {
  primary:
    'bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-600)] shadow-[var(--shadow-sm)] hover:shadow-[var(--shadow-md)]',
  secondary:
    'bg-[var(--color-accent)] text-[var(--color-primary-900)] hover:bg-[var(--color-accent-600)] shadow-[var(--shadow-sm)]',
  ghost:
    'bg-transparent text-[var(--color-primary)] hover:bg-[var(--color-surface-muted)]',
  outline:
    'bg-transparent text-[var(--color-primary)] border border-[var(--color-border-strong)] hover:border-[var(--color-primary)] hover:bg-[var(--color-primary-50)]',
  amazon:
    'bg-[var(--color-amazon)] text-[var(--color-amazon-ink)] hover:bg-[var(--color-amazon-hover)] font-semibold shadow-[var(--shadow-sm)] hover:shadow-[var(--shadow-md)]',
};

const sizeKey = size as Size;
const variantKey = variant as Variant;
const classes = cn(base, sizes[sizeKey], variants[variantKey], fullWidth && 'w-full', className);
---

{Tag === 'a' ? (
  <a href={href} rel={rel} target={target} aria-label={ariaLabel} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} aria-label={ariaLabel} disabled={disabled} class={classes}>
    <slot />
  </button>
)}
