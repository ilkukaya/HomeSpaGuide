---
interface Props {
  faqs: { question: string; answer: string }[];
}
const { faqs } = Astro.props;
---

<div class="faq-list">
  {faqs.map((f, i) => (
    <details class="faq-list__item" open={i === 0}>
      <summary><h3>{f.question}</h3></summary>
      <div class="faq-list__answer" set:html={f.answer.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')} />
    </details>
  ))}
</div>

<style>
  .faq-list { border-top: 1px solid var(--color-border-strong); }
  .faq-list__item { border-bottom: 1px solid var(--color-border); }
  .faq-list__item summary {
    list-style: none; cursor: pointer;
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding: 1rem 0;
  }
  .faq-list__item summary::-webkit-details-marker { display: none; }
  .faq-list__item summary h3 { font-family: var(--font-sans); font-size: 1.02rem; font-weight: 600; line-height: 1.4; color: var(--color-ink); letter-spacing: 0; }
  .faq-list__item summary::after {
    content: '+'; flex: 0 0 auto; font-size: 1.4rem; line-height: 1; color: var(--color-primary);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .faq-list__item[open] summary::after { transform: rotate(45deg); }
  .faq-list__item summary:hover h3 { color: var(--color-primary); }
  .faq-list__answer { padding: 0 0 1.1rem; color: var(--color-ink-muted); line-height: 1.65; max-width: 70ch; }
</style>
