---
import Logo from '../ui/Logo.astro';
import NewsletterForm from './NewsletterForm.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="container-page site-footer__signup">
    <div>
      <p class="site-footer__signup-eyebrow">The HomeSpaGuide Letter</p>
      <h2 class="site-footer__signup-title">Seasonal water-care reminders &amp; new buying guides.</h2>
      <p class="site-footer__signup-copy">One short email a month. No spam, unsubscribe anytime.</p>
    </div>
    <NewsletterForm id="footer" tone="on-dark" />
  </div>

  <div class="container-page site-footer__grid">
    <section class="site-footer__col site-footer__col--brand">
      <a href="/" aria-label="HomeSpaGuide home"><Logo tone="on-dark" /></a>
      <p class="site-footer__tag">
        Independent buying guides for inflatable and plug-and-play hot tubs, water chemistry, filters and the accessories that make a home spa easy to own.
      </p>
    </section>

    <nav class="site-footer__col" aria-label="Shop">
      <h3>Shop</h3>
      <ul>
        <li><a href="/category/hot-tubs">Hot tubs</a></li>
        <li><a href="/category/inflatable-hot-tubs">Inflatable hot tubs</a></li>
        <li><a href="/category/chemicals-water-care">Chemicals &amp; water care</a></li>
        <li><a href="/category/filters-filtration">Filters</a></li>
        <li><a href="/category/covers-accessories">Covers &amp; accessories</a></li>
        <li><a href="/products">All products</a></li>
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="Learn">
      <h3>Learn</h3>
      <ul>
        <li><a href="/guides">Buying guides</a></li>
        <li><a href="/blog">Advice &amp; how-tos</a></li>
        <li><a href="/faq">Hot tub FAQ</a></li>
        <li><a href="/compare">Compare products</a></li>
        <li><a href="/rss.xml">RSS feed</a></li>
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="Company">
      <h3>Company</h3>
      <ul>
        <li><a href="/about">About us</a></li>
        <li><a href="/editorial-policy">How we choose &amp; score</a></li>
        <li><a href="/affiliate-disclosure">Affiliate disclosure</a></li>
        <li><a href="/contact">Contact &amp; corrections</a></li>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
      </ul>
    </nav>
  </div>

  <div class="container-page site-footer__legal">
    <p>
      HomeSpaGuide is reader-supported. As an Amazon Associate, HomeSpaGuide earns from qualifying purchases. Amazon and the Amazon logo are trademarks of Amazon.com, Inc. or its affiliates. Product prices and availability are accurate as of the date/time indicated on Amazon and are subject to change.
    </p>
    <p>
      Hot tub use carries health risks for some people. Nothing on this site is medical advice — follow your manufacturer’s manual and consult a doctor if you are pregnant or have a medical condition.
    </p>
    <p class="site-footer__copy">© {year} HomeSpaGuide. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    background: var(--color-primary-900);
    color: rgba(248, 246, 241, 0.82);
  }
  .site-footer__signup {
    display: grid;
    gap: 1.5rem;
    padding-top: 3rem;
    padding-bottom: 2.75rem;
    border-bottom: 1px solid rgba(248, 246, 241, 0.12);
    align-items: end;
  }
  @media (min-width: 900px) {
    .site-footer__signup { grid-template-columns: 1.2fr 1fr; gap: 3rem; }
  }
  .site-footer__signup-eyebrow {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    color: #E7A57F;
    margin-bottom: 0.6rem;
  }
  .site-footer__signup-title {
    color: var(--color-ink-on-dark);
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.1rem);
    max-width: 22ch;
  }
  .site-footer__signup-copy { margin-top: 0.6rem; font-size: 0.95rem; color: rgba(248, 246, 241, 0.65); }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.5rem;
    padding-top: 2.75rem;
    padding-bottom: 2.25rem;
  }
  .site-footer__col--brand { grid-column: 1 / -1; }
  @media (min-width: 900px) {
    .site-footer__grid { grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 3rem; }
    .site-footer__col--brand { grid-column: auto; }
  }
  .site-footer__tag { margin-top: 1rem; font-size: 0.925rem; line-height: 1.6; max-width: 38ch; color: rgba(248, 246, 241, 0.65); }
  .site-footer h3 {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(248, 246, 241, 0.55);
    margin-bottom: 0.9rem;
  }
  .site-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.1rem; }
  .site-footer li a {
    display: inline-block;
    padding: 0.3rem 0;
    color: rgba(248, 246, 241, 0.88);
    font-size: 0.925rem;
  }
  .site-footer li a:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  .site-footer__legal {
    border-top: 1px solid rgba(248, 246, 241, 0.12);
    padding-top: 1.5rem;
    padding-bottom: 2rem;
    display: grid;
    gap: 0.75rem;
    font-size: 0.78rem;
    line-height: 1.6;
    color: rgba(248, 246, 241, 0.55);
  }
  .site-footer__legal p { max-width: 110ch; }
  .site-footer__copy { color: rgba(248, 246, 241, 0.45); }
</style>
