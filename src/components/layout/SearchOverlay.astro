---
import { getCollection } from 'astro:content';
import { Search, X } from 'lucide-react';

const products = await getCollection('products', ({ data }) => data.status === 'active');
const guides = await getCollection('guides').catch(() => []);
const blog = await getCollection('blog').catch(() => []);
const categories = await getCollection('categories').catch(() => []);
const brands = await getCollection('brands').catch(() => []);

const index = [
  ...products.map((p) => ({
    type: 'Product',
    title: p.data.shortTitle,
    href: `/products/${p.slug}`,
    snippet: p.data.shortDescription,
  })),
  ...guides.map((g) => ({
    type: 'Guide',
    title: g.data.title,
    href: `/guides/${g.slug}`,
    snippet: g.data.intro,
  })),
  ...blog.map((b) => ({
    type: 'Blog',
    title: b.data.title,
    href: `/blog/${b.slug}`,
    snippet: b.data.excerpt,
  })),
  ...categories.map((c) => ({
    type: 'Category',
    title: c.data.name,
    href: `/category/${c.slug}`,
    snippet: c.data.shortDescription,
  })),
  ...brands.map((b) => ({
    type: 'Brand',
    title: b.data.name,
    href: `/brand/${b.slug}`,
    snippet: b.data.description,
  })),
];
---

<div class="hsg-search" data-search-overlay hidden role="dialog" aria-modal="true" aria-label="Search">
  <div class="hsg-search__backdrop" data-search-close></div>
  <div class="hsg-search__panel">
    <div class="hsg-search__head">
      <Search size={20} aria-hidden="true" />
      <input
        type="search"
        data-search-input
        placeholder="Search products, guides, brands…"
        autocomplete="off"
        spellcheck="false"
      />
      <button class="hsg-search__close" type="button" data-search-close aria-label="Close search">
        <X size={20} aria-hidden="true" />
      </button>
    </div>
    <div class="hsg-search__results" data-search-results>
      <p class="hsg-search__hint">Try a brand (Intex, Bestway), a category (chemicals, filters), or a use-case (winter, freeze-rated, budget).</p>
    </div>
    <p class="hsg-search__foot">Press <kbd>Esc</kbd> to close · <kbd>↑↓</kbd> to navigate · <kbd>↵</kbd> to open</p>
  </div>
</div>

<script type="application/json" id="hsg-search-index" set:html={JSON.stringify(index)} />

<style>
  .hsg-search {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 8vh;
    animation: hsg-search-in var(--dur-base) var(--ease-out);
  }
  @keyframes hsg-search-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .hsg-search[hidden] { display: none; }
  .hsg-search__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 30, 32, 0.6);
  }
  .hsg-search__panel {
    position: relative;
    width: min(640px, 92%);
    background: var(--color-paper);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 78vh;
  }
  .hsg-search__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.1rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-ink-muted);
  }
  .hsg-search__head input {
    flex: 1;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: var(--text-lg);
    color: var(--color-ink);
    outline: none;
  }
  .hsg-search__head input::placeholder { color: var(--color-ink-subtle); }
  .hsg-search__close {
    color: var(--color-ink-muted);
    padding: 0.4rem;
    border-radius: var(--radius-md);
  }
  .hsg-search__close:hover { background: var(--color-paper-deep); color: var(--color-primary); }
  .hsg-search__results {
    overflow-y: auto;
    padding: 0.5rem 0;
  }
  .hsg-search__hint {
    padding: 1.5rem 1.5rem;
    color: var(--color-ink-muted);
    font-size: 0.95rem;
    line-height: var(--leading-normal);
    text-align: center;
  }
  .hsg-search__group {
    padding: 0.85rem 0.65rem 0.65rem;
  }
  .hsg-search__group h3 {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    color: var(--color-cedar);
    margin: 0 0.75rem 0.5rem;
  }
  .hsg-search__item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius-md);
    color: var(--color-primary-900);
    cursor: pointer;
  }
  .hsg-search__item:hover,
  .hsg-search__item.is-active {
    background: var(--color-steam);
    color: var(--color-primary-900);
  }
  .hsg-search__item-title {
    font-weight: 600;
    font-family: var(--font-serif);
    font-size: 1.02rem;
  }
  .hsg-search__item-snippet {
    color: var(--color-ink-muted);
    font-size: 0.85rem;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .hsg-search__empty {
    padding: 2rem 1.5rem;
    text-align: center;
    color: var(--color-ink-muted);
  }
  .hsg-search__foot {
    padding: 0.65rem 1.1rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-ink-subtle);
    font-size: 0.8rem;
    background: var(--color-paper-deep);
    text-align: center;
  }
  .hsg-search__foot kbd {
    display: inline-block;
    padding: 0.05rem 0.4rem;
    background: var(--color-surface);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink);
  }
</style>

<script>
  type Item = { type: string; title: string; href: string; snippet: string };

  const overlay = document.querySelector<HTMLElement>('[data-search-overlay]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const resultsBox = document.querySelector<HTMLElement>('[data-search-results]');
  const rawIndex = document.getElementById('hsg-search-index')?.textContent || '[]';
  const idx: Item[] = JSON.parse(rawIndex);

  let activeIdx = 0;
  let currentResults: Item[] = [];

  function open() {
    if (!overlay) return;
    overlay.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    setTimeout(() => input?.focus(), 50);
  }
  function close() {
    if (!overlay) return;
    overlay.setAttribute('hidden', '');
    document.body.style.overflow = '';
    if (input) input.value = '';
    render('');
  }

  function score(item: Item, q: string): number {
    const t = item.title.toLowerCase();
    const s = item.snippet.toLowerCase();
    const ql = q.toLowerCase();
    if (t.startsWith(ql)) return 3;
    if (t.includes(ql)) return 2;
    if (s.includes(ql)) return 1;
    return 0;
  }

  function render(q: string) {
    if (!resultsBox) return;
    if (!q.trim()) {
      resultsBox.innerHTML = '<p class="hsg-search__hint">Try a brand (Intex, Bestway), a category (chemicals, filters), or a use-case (winter, freeze-rated, budget).</p>';
      currentResults = [];
      return;
    }
    const ql = q.toLowerCase();
    const matches = idx
      .map((it) => ({ it, s: score(it, ql) }))
      .filter((m) => m.s > 0)
      .sort((a, b) => b.s - a.s)
      .slice(0, 20)
      .map((m) => m.it);

    currentResults = matches;
    activeIdx = 0;

    if (matches.length === 0) {
      resultsBox.innerHTML = `<div class="hsg-search__empty">No matches for "<strong>${escapeHtml(q)}</strong>". Try a brand or category name.</div>`;
      return;
    }

    const groups: Record<string, Item[]> = {};
    for (const m of matches) {
      (groups[m.type] ||= []).push(m);
    }

    let html = '';
    const order = ['Product', 'Guide', 'Blog', 'Category', 'Brand'];
    for (const g of order) {
      if (!groups[g]?.length) continue;
      html += `<div class="hsg-search__group"><h3>${g === 'Blog' ? 'From the blog' : g + 's'}</h3>`;
      for (const it of groups[g]!) {
        const gi = matches.indexOf(it);
        html += `<a class="hsg-search__item" href="${it.href}" data-idx="${gi}">
          <span class="hsg-search__item-title">${escapeHtml(it.title)}</span>
          <span class="hsg-search__item-snippet">${escapeHtml(it.snippet)}</span>
        </a>`;
      }
      html += `</div>`;
    }
    resultsBox.innerHTML = html;
    setActive(0);
  }

  function setActive(i: number) {
    if (!resultsBox) return;
    const items = resultsBox.querySelectorAll<HTMLElement>('.hsg-search__item');
    if (!items.length) return;
    activeIdx = Math.max(0, Math.min(items.length - 1, i));
    items.forEach((el, n) => el.classList.toggle('is-active', n === activeIdx));
    items[activeIdx]?.scrollIntoView({ block: 'nearest' });
  }

  function escapeHtml(s: string) {
    return s.replace(/[&<>"']/g, (c) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]!));
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-search-trigger]')) {
      e.preventDefault();
      open();
    }
    if (t.closest('[data-search-close]')) close();
  });

  input?.addEventListener('input', () => render(input.value));
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { close(); return; }
    if (e.key === 'ArrowDown') { e.preventDefault(); setActive(activeIdx + 1); return; }
    if (e.key === 'ArrowUp') { e.preventDefault(); setActive(activeIdx - 1); return; }
    if (e.key === 'Enter') {
      const items = resultsBox?.querySelectorAll<HTMLAnchorElement>('.hsg-search__item');
      const target = items?.[activeIdx];
      if (target) {
        e.preventDefault();
        window.location.href = target.href;
      }
    }
  });

  // global Cmd+K / Ctrl+K
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      open();
    }
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
      e.preventDefault();
      open();
    }
  });
</script>
