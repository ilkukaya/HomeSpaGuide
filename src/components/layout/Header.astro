---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Search, Heart, GitCompare, Menu, X, ChevronDown } from 'lucide-react';
import MegaMenu from './MegaMenu.astro';

const categories: CollectionEntry<'categories'>[] = await getCollection('categories').catch(() => []);
const topLevel = categories
  .filter((c) => !c.data.parent)
  .sort((a, b) => a.data.order - b.data.order);

const subsByParentSlug = new Map<string, CollectionEntry<'categories'>[]>();
for (const cat of categories) {
  if (!cat.data.parent) continue;
  const parentEntry = categories.find((c) => c.id === cat.data.parent!.id || c.slug === cat.data.parent!.id);
  const key = parentEntry?.slug ?? cat.data.parent.id;
  if (!subsByParentSlug.has(key)) subsByParentSlug.set(key, []);
  subsByParentSlug.get(key)!.push(cat);
}
---

<header class="site-header">
  <div class="container-page site-header__inner">
    <a href="/" class="site-header__logo" aria-label="HomeSpaGuide home">
      <svg class="logo-mark" viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" rx="14" fill="var(--color-primary)" />
        <circle cx="32" cy="36" r="18" fill="var(--color-amber)" />
        <path d="M14 38 Q22 32 32 38 T50 38" stroke="var(--color-paper)" stroke-width="2.5" fill="none" stroke-linecap="round" />
        <path d="M14 46 Q22 40 32 46 T50 46" stroke="var(--color-paper)" stroke-width="2.5" fill="none" stroke-linecap="round" />
      </svg>
      <span class="logo-text">HomeSpaGuide</span>
    </a>

    <div class="site-header__nav">
      <MegaMenu />
    </div>

    <div class="site-header__actions">
      <button type="button" data-search-trigger class="icon-btn" aria-label="Search (Cmd+K)">
        <Search size={20} aria-hidden="true" />
      </button>
      <a href="/wishlist" class="icon-btn icon-btn--badge" aria-label="Wishlist">
        <Heart size={20} aria-hidden="true" />
        <span data-wishlist-count class="badge" hidden>0</span>
      </a>
      <a href="/compare" class="icon-btn icon-btn--badge" aria-label="Compare">
        <GitCompare size={20} aria-hidden="true" />
        <span data-compare-count class="badge" hidden>0</span>
      </a>
      <button class="icon-btn site-header__menu-toggle" data-mobile-toggle aria-label="Menu" aria-expanded="false">
        <Menu size={22} aria-hidden="true" />
      </button>
    </div>
  </div>

  <div class="mobile-drawer" data-mobile-drawer hidden>
    <div class="mobile-drawer__head">
      <span class="mobile-drawer__brand">
        <svg class="logo-mark" viewBox="0 0 64 64" aria-hidden="true">
          <rect width="64" height="64" rx="14" fill="var(--color-primary)" />
          <circle cx="32" cy="36" r="18" fill="var(--color-amber)" />
          <path d="M14 38 Q22 32 32 38 T50 38" stroke="var(--color-paper)" stroke-width="2.5" fill="none" stroke-linecap="round" />
          <path d="M14 46 Q22 40 32 46 T50 46" stroke="var(--color-paper)" stroke-width="2.5" fill="none" stroke-linecap="round" />
        </svg>
        <span class="logo-text">HomeSpaGuide</span>
      </span>
      <button class="icon-btn" data-mobile-close aria-label="Close menu">
        <X size={22} aria-hidden="true" />
      </button>
    </div>
    <ul class="mobile-drawer__list">
      {topLevel.map((cat) => {
        const subs = subsByParentSlug.get(cat.slug) ?? [];
        return (
          <li class="mobile-drawer__group">
            <a href={`/category/${cat.slug}`} class="mobile-drawer__group-head">
              <span>{cat.data.name}</span>
              <span class="mobile-drawer__group-desc">{cat.data.shortDescription}</span>
            </a>
            {subs.length > 0 && (
              <ul class="mobile-drawer__sublist">
                {subs.map((s) => (
                  <li><a href={`/category/${s.slug}`}>{s.data.name}</a></li>
                ))}
              </ul>
            )}
          </li>
        );
      })}
      <li class="mobile-drawer__divider" aria-hidden="true"></li>
      <li><a href="/guides">Buying Guides</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/wishlist">Wishlist</a></li>
      <li><a href="/compare">Compare</a></li>
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-border);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: var(--header-height);
  }
  .site-header__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-primary-900);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.012em;
  }
  .logo-mark { width: 28px; height: 28px; display: block; flex-shrink: 0; }
  .site-header__nav { flex: 1; }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .icon-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    color: var(--color-ink-muted);
    transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);
  }
  .icon-btn:hover { background: var(--color-paper-deep); color: var(--color-primary); }
  .badge {
    position: absolute;
    top: 4px;
    right: 4px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    background: var(--color-cedar);
    color: var(--color-ink-on-dark);
    border-radius: var(--radius-full);
    font-size: 11px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .site-header__menu-toggle { display: inline-flex; }
  .mobile-drawer {
    position: fixed;
    inset: 0;
    background: var(--color-paper);
    z-index: 50;
    padding: 1.25rem;
    overflow-y: auto;
  }
  .mobile-drawer__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .mobile-drawer__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-sans);
    font-weight: 700;
    color: var(--color-primary-900);
    letter-spacing: -0.012em;
  }
  .mobile-drawer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .mobile-drawer__list a {
    display: block;
    padding: 0.85rem 0.5rem;
    color: var(--color-ink);
    font-size: var(--text-lg);
    border-bottom: 1px solid var(--color-border);
  }
  .mobile-drawer__group {
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-border);
  }
  .mobile-drawer__group-head {
    display: flex !important;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.85rem 0.5rem 0.5rem !important;
    border-bottom: 0 !important;
    color: var(--color-primary-900) !important;
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: -0.005em;
  }
  .mobile-drawer__group-desc { font-family: var(--font-sans); font-weight: 400; color: var(--color-ink-muted); font-size: var(--text-sm); }
  .mobile-drawer__sublist {
    list-style: none;
    margin: 0;
    padding: 0 0 0.5rem 0.5rem;
    display: flex;
    flex-direction: column;
  }
  .mobile-drawer__sublist a {
    padding: 0.55rem 0.5rem !important;
    border-bottom: 0 !important;
    font-size: var(--text-base) !important;
    color: var(--color-ink-muted) !important;
  }
  .mobile-drawer__divider { height: 1rem; }

  @media (min-width: 900px) {
    .site-header__menu-toggle { display: none; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const close = document.querySelector<HTMLButtonElement>('[data-mobile-close]');
  const drawer = document.querySelector<HTMLDivElement>('[data-mobile-drawer]');
  toggle?.addEventListener('click', () => {
    drawer?.removeAttribute('hidden');
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  });
  close?.addEventListener('click', () => {
    drawer?.setAttribute('hidden', '');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  });
  // close drawer on internal link click
  drawer?.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a');
    if (a) {
      drawer.setAttribute('hidden', '');
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
  });

  function readCount(key: string): number {
    try {
      const raw = localStorage.getItem(key);
      if (!raw) return 0;
      const arr = JSON.parse(raw);
      return Array.isArray(arr) ? arr.length : 0;
    } catch {
      return 0;
    }
  }
  function update(selector: string, count: number) {
    const el = document.querySelector<HTMLElement>(selector);
    if (!el) return;
    if (count > 0) {
      el.hidden = false;
      el.textContent = String(count);
    } else {
      el.hidden = true;
    }
  }
  update('[data-wishlist-count]', readCount('hsg.wishlist'));
  update('[data-compare-count]', readCount('hsg.compare'));
  window.addEventListener('storage', () => {
    update('[data-wishlist-count]', readCount('hsg.wishlist'));
    update('[data-compare-count]', readCount('hsg.compare'));
  });
  window.addEventListener('hsg:wishlist:change', () => update('[data-wishlist-count]', readCount('hsg.wishlist')));
  window.addEventListener('hsg:compare:change', () => update('[data-compare-count]', readCount('hsg.compare')));

</script>
