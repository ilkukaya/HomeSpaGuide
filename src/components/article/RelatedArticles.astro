---
import { getCollection } from 'astro:content';

interface Props {
  currentHref: string;
  tags?: string[];
  limit?: number;
}
const { currentHref, tags = [], limit = 3 } = Astro.props;
const [blog, guides] = await Promise.all([getCollection('blog'), getCollection('guides')]);
const items = [
  ...blog.map((b) => ({ href: `/blog/${b.slug}`, title: b.data.title, tags: b.data.tags, kind: b.data.category.replace(/-/g, ' '), date: b.data.updatedAt ?? b.data.publishedAt })),
  ...guides.map((g) => ({ href: `/guides/${g.slug}`, title: g.data.title, tags: [g.data.topic.toLowerCase()], kind: 'guide', date: g.data.updatedAt })),
]
  .filter((i) => i.href !== currentHref)
  .map((i) => ({ ...i, overlap: i.tags.filter((t) => tags.includes(t)).length }))
  .sort((a, b) => b.overlap - a.overlap || +b.date - +a.date)
  .slice(0, limit);
---

{items.length > 0 && (
  <section class="related-articles" aria-labelledby="related-articles-title">
    <h2 id="related-articles-title">Keep reading</h2>
    <ul>
      {items.map((i) => (
        <li>
          <a href={i.href}>
            <span class="related-articles__kind">{i.kind}</span>
            <span class="related-articles__title">{i.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .related-articles h2 { font-size: 1.5rem; margin-bottom: 0.75rem; }
  .related-articles ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; grid-template-columns: 1fr; border-top: 1px solid var(--color-ink); }
  @media (min-width: 800px) { .related-articles ul { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 2rem; } }
  .related-articles li { border-bottom: 1px solid var(--color-border); }
  .related-articles a { display: flex; flex-direction: column; gap: 0.3rem; padding: 1rem 0; color: var(--color-ink); }
  .related-articles__kind { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; color: var(--color-cedar); }
  .related-articles__title { font-family: var(--font-serif); font-size: 1.15rem; font-weight: 550; line-height: 1.3; }
  .related-articles a:hover .related-articles__title { color: var(--color-primary); }
</style>
