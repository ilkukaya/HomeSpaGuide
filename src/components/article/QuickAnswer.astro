---
interface Props {
  answer?: string;
  takeaways?: string[];
}
const { answer, takeaways = [] } = Astro.props;
const md = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---

{(answer || takeaways.length > 0) && (
  <aside class="qa" aria-label="Quick answer">
    {answer && (
      <>
        <p class="qa__label">The short answer</p>
        <p class="qa__answer" set:html={md(answer)} />
      </>
    )}
    {takeaways.length > 0 && (
      <>
        <p class="qa__label qa__label--sub">Key takeaways</p>
        <ul class="qa__list">
          {takeaways.map((t) => <li set:html={md(t)} />)}
        </ul>
      </>
    )}
  </aside>
)}

<style>
  .qa {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-md);
    padding: 1.15rem 1.3rem 1.25rem;
    max-width: 70ch;
  }
  .qa__label { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.09em; color: var(--color-cedar); }
  .qa__label--sub { margin-top: 1.1rem; padding-top: 1rem; border-top: 1px solid var(--color-border); }
  .qa__answer { margin-top: 0.4rem; font-size: 1.08rem; line-height: 1.6; color: var(--color-ink); }
  .qa__list { margin: 0.5rem 0 0; padding-left: 1.2rem; display: grid; gap: 0.4rem; color: var(--color-ink); line-height: 1.55; }
  .qa__list li::marker { color: var(--color-primary); }
</style>
