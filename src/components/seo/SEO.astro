---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og/default.png',
  ogImageAlt = 'HomeSpaGuide — curated guides to home spas and hot tubs',
  ogType = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

const siteUrl = import.meta.env.SITE;
// Canonicals never carry query strings and never end in a slash (except root).
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/+$/, '') || '/';
const canonicalUrl = canonical || new URL(cleanPath, siteUrl).toString();
const absoluteOg = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).toString();
const fullTitle = title.includes('HomeSpaGuide') ? title : `${title} | HomeSpaGuide`;
const ogTypeTag = ogType === 'product' ? 'website' : ogType; // og:type=product is non-standard without a price

const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const pinterestVerification = import.meta.env.PUBLIC_PINTEREST_VERIFICATION;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta
  name="robots"
  content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>

<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content="HomeSpaGuide" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogTypeTag} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={absoluteOg} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOg} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<meta name="theme-color" content="#F8F6F1" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="format-detection" content="telephone=no" />

{googleVerification && <meta name="google-site-verification" content={googleVerification} />}
{bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
{pinterestVerification && <meta name="p:domain_verify" content={pinterestVerification} />}
