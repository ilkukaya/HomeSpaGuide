---
interface Props {
  title: string;
  description: string;
  url: string;
  imageUrl: string;
  publishedAt: Date;
  updatedAt?: Date;
  type?: 'Article' | 'BlogPosting';
  keywords?: string[];
}
const { title, description, url, imageUrl, publishedAt, updatedAt, type = 'Article', keywords = [] } = Astro.props;
const siteUrl = import.meta.env.SITE;
const org = new URL('/#organization', siteUrl).toString();
const schema = {
  '@context': 'https://schema.org',
  '@type': type,
  '@id': `${url}#article`,
  headline: title,
  description,
  image: [imageUrl],
  url,
  inLanguage: 'en-US',
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  author: { '@type': 'Organization', name: 'HomeSpaGuide Editors', url: new URL('/about', siteUrl).toString() },
  publisher: { '@id': org },
  isPartOf: { '@id': new URL('/#website', siteUrl).toString() },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  ...(keywords.length ? { keywords: keywords.join(', ') } : {}),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
