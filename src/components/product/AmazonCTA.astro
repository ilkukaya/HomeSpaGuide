---
import { ArrowUpRight } from 'lucide-react';
import { buildAmazonUrl, amazonRel } from '../../lib/amazon';
import { cn } from '../../lib/cn';

type Size = 'sm' | 'md' | 'lg';

interface Props {
  asin: string;
  campaign?: string;
  label?: string;
  size?: Size;
  fullWidth?: boolean;
  class?: string;
}

const {
  asin,
  campaign,
  label = 'View on Amazon',
  size = 'md',
  fullWidth = false,
  class: className,
} = Astro.props;

const href = buildAmazonUrl(asin, campaign ? { campaign } : {});

const sizes: Record<Size, string> = {
  sm: 'px-3.5 h-10 text-[0.9rem] gap-1.5',
  md: 'px-5 h-12 text-base gap-2',
  lg: 'px-6 h-14 text-[1.05rem] gap-2',
};
---

<a
  href={href}
  rel={amazonRel()}
  target="_blank"
  class={cn(
    'amazon-cta inline-flex items-center justify-center font-semibold whitespace-nowrap rounded-[var(--radius-md)] bg-[var(--color-amazon)] text-[var(--color-amazon-ink)] hover:bg-[var(--color-amazon-hover)] hover:text-[var(--color-amazon-ink)] border border-[#FCD200] transition-colors duration-150 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amazon-ink)]',
    sizes[size],
    fullWidth && 'w-full',
    className,
  )}
  data-amazon-cta
  data-asin={asin}
  data-placement={campaign}
>
  <span>{label}</span>
  <ArrowUpRight size={size === 'lg' ? 20 : 17} aria-hidden="true" />
</a>
