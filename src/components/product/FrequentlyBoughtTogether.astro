---
import { Image } from 'astro:assets';
import { getEntry, type CollectionEntry } from 'astro:content';
import AmazonCTA from './AmazonCTA.astro';
import { PRICE_RANGES } from '../../lib/prices';

interface Props {
  current: CollectionEntry<'products'>;
  refs?: CollectionEntry<'products'>['data']['frequentlyBoughtWith'];
}
const { current, refs = [] } = Astro.props;

const items = (
  await Promise.all((refs ?? []).map((r) => getEntry('products', r.id)))
).filter((p): p is CollectionEntry<'products'> => Boolean(p));
---

{items.length > 0 && (
  <section class="pairs">
    <h2>What you’ll also need</h2>
    <p class="pairs__hint">Consumables and add-ons owners of the {current.data.shortTitle} typically pick up. Each links to its own Amazon listing.</p>
    <ul class="pairs__list">
      {items.map((p) => (
        <li class="pairs__item">
          <a href={`/products/${p.slug}`} class="pairs__thumb" tabindex="-1" aria-hidden="true">
            <Image src={p.data.primaryImage} alt="" widths={[96, 192]} sizes="96px" format="webp" />
          </a>
          <div class="pairs__text">
            <a href={`/products/${p.slug}`} class="pairs__name">{p.data.shortTitle}</a>
            <span class="pairs__meta">{PRICE_RANGES[p.data.priceRange].label} · {p.data.editorScore.overall.toFixed(1)}/10</span>
          </div>
          <AmazonCTA asin={p.data.asin} campaign="pdp-pairs" size="sm" label="View" />
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .pairs h2 { font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.9rem); margin-bottom: 0.35rem; }
  .pairs__hint { color: var(--color-ink-muted); font-size: 0.92rem; margin-bottom: 1rem; }
  .pairs__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-border-strong); }
  .pairs__item {
    display: grid; grid-template-columns: 72px minmax(0, 1fr) auto; gap: 0.9rem; align-items: center;
    padding: 0.75rem 0; border-bottom: 1px solid var(--color-border);
  }
  .pairs__thumb img { width: 72px; height: 54px; object-fit: cover; border-radius: var(--radius-sm); background: var(--color-paper-deep); }
  .pairs__text { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .pairs__name { color: var(--color-ink); font-weight: 600; line-height: 1.3; }
  .pairs__name:hover { color: var(--color-primary); }
  .pairs__meta { color: var(--color-ink-subtle); font-size: 0.82rem; }
</style>
