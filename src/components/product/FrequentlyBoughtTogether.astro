---
import { Image } from 'astro:assets';
import { Plus } from 'lucide-react';
import { getEntry, type CollectionEntry } from 'astro:content';
import AmazonCTA from './AmazonCTA.astro';
import { PRICE_RANGES, sumPriceRanges, formatRange } from '../../lib/prices';

interface Props {
  current: CollectionEntry<'products'>;
  refs?: CollectionEntry<'products'>['data']['frequentlyBoughtWith'];
}
const { current, refs = [] } = Astro.props;

const items = (
  await Promise.all((refs ?? []).map((r) => getEntry('products', r.id)))
).filter((p): p is CollectionEntry<'products'> => Boolean(p));

if (items.length === 0) {
  // nothing to render
}

const all = [current, ...items];
const total = sumPriceRanges(all.map((p) => p.data.priceRange));
---

{items.length > 0 && (
  <section class="fbt">
    <h2>Frequently bought together</h2>
    <p class="fbt__hint">Each item links to its own Amazon listing — no bundles, separate checkouts.</p>
    <div class="fbt__row">
      {all.map((p, i) => (
        <>
          <a href={`/products/${p.slug}`} class="fbt__item">
            <Image src={p.data.primaryImage} alt={p.data.imageAlt} widths={[120, 200]} format="webp" />
            <span>{p.data.shortTitle}</span>
            <small>{PRICE_RANGES[p.data.priceRange].label}</small>
          </a>
          {i < all.length - 1 && <Plus size={20} aria-hidden="true" />}
        </>
      ))}
    </div>
    <div class="fbt__totals">
      <p><strong>Total estimated:</strong> {formatRange(total)}</p>
      <div class="fbt__ctas">
        {all.map((p) => (
          <AmazonCTA asin={p.data.asin} campaign="fbt" size="sm" label={`View on Amazon`} />
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .fbt { border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 1.5rem; background: var(--color-surface); }
  .fbt h2 { font-size: var(--text-2xl); margin-bottom: 0.25rem; }
  .fbt__hint { color: var(--color-ink-subtle); font-size: 0.9rem; margin-bottom: 1.25rem; }
  .fbt__row { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .fbt__row svg { color: var(--color-ink-subtle); flex-shrink: 0; }
  .fbt__item { display: flex; flex-direction: column; gap: 0.35rem; width: 140px; text-align: center; color: var(--color-ink); font-size: 0.85rem; }
  .fbt__item img { aspect-ratio: 1/1; object-fit: cover; border-radius: var(--radius-md); background: var(--color-surface-muted); }
  .fbt__item small { color: var(--color-ink-subtle); }
  .fbt__totals { margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid var(--color-border); display: flex; flex-direction: column; gap: 0.85rem; }
  .fbt__ctas { display: flex; gap: 0.5rem; flex-wrap: wrap; }
</style>
