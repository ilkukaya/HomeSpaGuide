---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import AmazonCTA from './AmazonCTA.astro';
import { PRICE_RANGES } from '../../lib/prices';

interface Props {
  products: CollectionEntry<'products'>[];
  heading: string;
  campaign: string;
  id?: string;
}
const { products, heading, campaign, id } = Astro.props;
---

{products.length > 0 && (
  <section class="mini" id={id}>
    <p class="mini__heading">{heading}</p>
    <ul class="mini__list">
      {products.map((p) => (
        <li class="mini__item">
          <a href={`/products/${p.slug}`} class="mini__thumb" tabindex="-1" aria-hidden="true">
            <Image src={p.data.primaryImage} alt="" widths={[96, 192]} sizes="80px" format="webp" />
          </a>
          <div class="mini__text">
            <a href={`/products/${p.slug}`} class="mini__name">{p.data.shortTitle}</a>
            <span class="mini__why">{p.data.quickVerdict ?? p.data.shortDescription}</span>
            <span class="mini__meta">{PRICE_RANGES[p.data.priceRange].label} · Editor Score {p.data.editorScore.overall.toFixed(1)}</span>
          </div>
          <AmazonCTA asin={p.data.asin} campaign={campaign} size="sm" label="Check price" class="mini__cta" />
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .mini { border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); padding: 0.4rem 1.1rem 0.2rem; max-width: 70ch; }
  .mini__heading { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.09em; color: var(--color-cedar); padding: 0.7rem 0 0.3rem; }
  .mini__list { list-style: none; margin: 0; padding: 0; }
  .mini__item { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 0.4rem 0.9rem; align-items: center; padding: 0.85rem 0; border-top: 1px solid var(--color-border); }
  .mini__item:first-child { border-top: 0; }
  .mini__thumb img { width: 64px; height: 48px; object-fit: cover; border-radius: var(--radius-sm); background: var(--color-paper-deep); }
  .mini__text { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .mini__name { color: var(--color-ink); font-weight: 650; line-height: 1.3; }
  .mini__name:hover { color: var(--color-primary); }
  .mini__why { color: var(--color-ink-muted); font-size: 0.86rem; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .mini__meta { color: var(--color-ink-subtle); font-size: 0.78rem; }
  :global(.mini__cta) { grid-column: 2; justify-self: start; }
  @media (min-width: 640px) {
    .mini__item { grid-template-columns: 64px minmax(0, 1fr) auto; }
    :global(.mini__cta) { grid-column: 3; }
  }
</style>
