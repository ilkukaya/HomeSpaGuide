---
import { Image } from 'astro:assets';
import { Heart, GitCompare } from 'lucide-react';
import type { CollectionEntry } from 'astro:content';
import Badge from '../ui/Badge.astro';
import AmazonCTA from './AmazonCTA.astro';
import { PRICE_RANGES } from '../../lib/prices';

interface Props {
  product: CollectionEntry<'products'>;
  campaign?: string;
  /** Optional rank shown as "No. 1" etc. on best-of lists. */
  rank?: number;
  headingLevel?: 'h2' | 'h3';
}

const { product, campaign = 'card', rank, headingLevel = 'h3' } = Astro.props;
const p = product.data;
const href = `/products/${product.slug}`;
const variantKey = (b: string) => b.toLowerCase().replace(/\s+/g, '-');
const badge = p.editorPick ? 'Editor Pick' : p.editorBadges[0];
const blurb = p.quickVerdict ?? p.shortDescription;
const Heading = headingLevel;
---

<article class="product-card" data-asin={p.asin}>
  <a href={href} class="product-card__media" tabindex="-1" aria-hidden="true">
    <Image
      src={p.primaryImage}
      alt=""
      widths={[320, 480, 640]}
      sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 92vw"
      format="webp"
      loading="lazy"
      decoding="async"
    />
    {rank && <span class="product-card__rank">No. {rank}</span>}
  </a>
  <div class="product-card__actions">
    <button class="product-card__icon" data-wishlist-toggle data-asin={p.asin} data-slug={product.slug} aria-label={`Save ${p.shortTitle}`}>
      <Heart size={16} aria-hidden="true" />
    </button>
    <button class="product-card__icon" data-compare-toggle data-asin={p.asin} data-slug={product.slug} aria-label={`Compare ${p.shortTitle}`}>
      <GitCompare size={16} aria-hidden="true" />
    </button>
  </div>

  <div class="product-card__body">
    <div class="product-card__kicker">
      {badge && <Badge variant={variantKey(badge) as any}>{badge}</Badge>}
      <span class="product-card__brand">{p.brand.id.replace(/-/g, ' ')}</span>
    </div>
    <Heading class="product-card__title">
      <a href={href}>{p.shortTitle}</a>
    </Heading>
    <p class="product-card__blurb">{blurb}</p>
    <dl class="product-card__facts">
      <div>
        <dt>Editor score</dt>
        <dd><strong>{p.editorScore.overall.toFixed(1)}</strong>/10</dd>
      </div>
      <div>
        <dt>Typical price</dt>
        <dd>{PRICE_RANGES[p.priceRange].label}</dd>
      </div>
    </dl>
    <div class="product-card__cta">
      <AmazonCTA asin={p.asin} campaign={campaign} size="sm" fullWidth label="Check price on Amazon" />
    </div>
  </div>
</article>

<style>
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .product-card:hover { border-color: var(--color-border-strong); box-shadow: 0 8px 24px -16px rgba(23, 25, 26, 0.35); }
  .product-card__media { position: relative; display: block; aspect-ratio: 4 / 3; background: var(--color-paper-deep); overflow: hidden; }
  .product-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 400ms var(--ease-out); }
  .product-card:hover .product-card__media img { transform: scale(1.03); }
  .product-card__rank {
    position: absolute; left: 0.75rem; top: 0.75rem;
    font-family: var(--font-serif); font-weight: 600; font-size: 1rem;
    background: var(--color-ink); color: var(--color-ink-on-dark);
    padding: 0.2rem 0.6rem; border-radius: 3px;
  }
  .product-card__actions { position: absolute; top: 0.6rem; right: 0.6rem; display: flex; gap: 0.35rem; }
  .product-card__icon {
    width: 34px; height: 34px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.94);
    color: var(--color-ink-muted);
    display: inline-flex; align-items: center; justify-content: center;
    box-shadow: 0 1px 2px rgba(23, 25, 26, 0.12);
    transition: color var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out);
  }
  .product-card__icon:hover { color: var(--color-primary); }
  .product-card__icon[data-active='true'] { color: #fff; background: var(--color-cedar); }
  .product-card__body { padding: 1rem 1.1rem 1.1rem; display: flex; flex-direction: column; gap: 0.6rem; flex: 1; }
  .product-card__kicker { display: flex; align-items: center; gap: 0.6rem; min-height: 20px; }
  .product-card__brand {
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--color-ink-subtle); font-weight: 600;
  }
  .product-card__title {
    font-family: var(--font-serif);
    font-size: 1.22rem;
    font-weight: 550;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .product-card__title a { color: var(--color-ink); }
  .product-card__title a::after { content: ''; position: absolute; inset: 0; z-index: 0; }
  .product-card__title a:hover { color: var(--color-primary); }
  .product-card__actions, .product-card__cta { z-index: 1; }
  .product-card__cta { position: relative; margin-top: auto; padding-top: 0.25rem; }
  .product-card__blurb {
    color: var(--color-ink-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .product-card__facts {
    display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;
    margin: 0.15rem 0 0; padding-top: 0.6rem;
    border-top: 1px solid var(--color-border);
  }
  .product-card__facts dt { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-ink-subtle); font-weight: 600; }
  .product-card__facts dd { margin: 0.1rem 0 0; font-size: 0.9rem; color: var(--color-ink-muted); font-variant-numeric: tabular-nums; }
  .product-card__facts dd strong { color: var(--color-ink); font-size: 1.05rem; font-weight: 700; }

  /* Phones: compact horizontal card — more products per screen, faster scanning. */
  @media (max-width: 639px) {
    .product-card { display: grid; grid-template-columns: 112px minmax(0, 1fr); }
    .product-card__media { aspect-ratio: auto; height: 100%; min-height: 150px; }
    .product-card__body { padding: 0.85rem 0.9rem 0.9rem; gap: 0.45rem; }
    .product-card__title { font-size: 1.08rem; padding-right: 2.2rem; }
    .product-card__blurb { -webkit-line-clamp: 2; font-size: 0.86rem; }
    .product-card__actions { top: 0.55rem; right: 0.55rem; }
    .product-card__actions [data-compare-toggle] { display: none; }
    .product-card__icon { width: 30px; height: 30px; box-shadow: none; background: var(--color-paper-deep); }
    .product-card__facts { padding-top: 0.45rem; }
    .product-card__rank { font-size: 0.8rem; left: 0.4rem; top: 0.4rem; }
  }
</style>

<script>
  function refreshActive() {
    let wishlist: string[] = [];
    let compare: string[] = [];
    try { wishlist = JSON.parse(localStorage.getItem('hsg.wishlist') || '[]'); } catch {}
    try { compare = JSON.parse(localStorage.getItem('hsg.compare') || '[]'); } catch {}
    document.querySelectorAll<HTMLButtonElement>('[data-wishlist-toggle]').forEach((btn) => {
      btn.dataset.active = wishlist.includes(btn.dataset.asin || '') ? 'true' : 'false';
    });
    document.querySelectorAll<HTMLButtonElement>('[data-compare-toggle]').forEach((btn) => {
      btn.dataset.active = compare.includes(btn.dataset.asin || '') ? 'true' : 'false';
    });
  }

  function toggle(key: string, asin: string, max?: number): string[] {
    let arr: string[] = [];
    try { arr = JSON.parse(localStorage.getItem(key) || '[]'); } catch {}
    if (arr.includes(asin)) {
      arr = arr.filter((x) => x !== asin);
    } else {
      if (max && arr.length >= max) arr = arr.slice(arr.length - max + 1);
      arr.push(asin);
    }
    localStorage.setItem(key, JSON.stringify(arr));
    return arr;
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const wish = target.closest('[data-wishlist-toggle]') as HTMLButtonElement | null;
    if (wish) {
      e.preventDefault();
      toggle('hsg.wishlist', wish.dataset.asin || '');
      refreshActive();
      window.dispatchEvent(new CustomEvent('hsg:wishlist:change'));
    }
    const cmp = target.closest('[data-compare-toggle]') as HTMLButtonElement | null;
    if (cmp) {
      e.preventDefault();
      toggle('hsg.compare', cmp.dataset.asin || '', 4);
      refreshActive();
      window.dispatchEvent(new CustomEvent('hsg:compare:change'));
    }
  });

  refreshActive();
</script>
