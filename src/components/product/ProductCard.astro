---
import { Image } from 'astro:assets';
import { Heart, GitCompare } from 'lucide-react';
import type { CollectionEntry } from 'astro:content';
import Badge from '../ui/Badge.astro';
import PriceRangeBadge from './PriceRangeBadge.astro';
import EditorScore from './EditorScore.astro';
import AmazonCTA from './AmazonCTA.astro';

interface Props {
  product: CollectionEntry<'products'>;
  campaign?: string;
}

const { product, campaign = 'card' } = Astro.props;
const p = product.data;
const href = `/products/${product.slug}`;
const variantKey = (b: string) => b.toLowerCase().replace(/\s+/g, '-');
---

<article class="product-card" data-asin={p.asin}>
  <div class="product-card__media">
    <a href={href} aria-label={p.title}>
      <Image
        src={p.primaryImage}
        alt={p.imageAlt}
        widths={[240, 360, 480]}
        sizes="(min-width: 1024px) 280px, (min-width: 640px) 40vw, 90vw"
        format="webp"
        loading="lazy"
        decoding="async"
      />
    </a>
    {p.editorBadges?.length > 0 && (
      <div class="product-card__badges">
        {p.editorBadges.slice(0, 2).map((b) => (
          <Badge variant={variantKey(b) as any}>{b}</Badge>
        ))}
      </div>
    )}
    <div class="product-card__actions">
      <button class="product-card__icon" data-wishlist-toggle data-asin={p.asin} data-slug={product.slug} aria-label="Add to wishlist">
        <Heart size={16} aria-hidden="true" />
      </button>
      <button class="product-card__icon" data-compare-toggle data-asin={p.asin} data-slug={product.slug} aria-label="Add to compare">
        <GitCompare size={16} aria-hidden="true" />
      </button>
    </div>
    <div class="product-card__score">
      <EditorScore score={p.editorScore} layout="badge" />
    </div>
  </div>

  <div class="product-card__body">
    <p class="product-card__brand">{p.brand.id.replace(/-/g, ' ')}</p>
    <h3 class="product-card__title">
      <a href={href}>{p.shortTitle}</a>
    </h3>
    <div class="product-card__meta">
      <PriceRangeBadge range={p.priceRange} variant="short" />
    </div>
    <div class="product-card__cta">
      <AmazonCTA asin={p.asin} campaign={campaign} size="sm" label="View on Amazon" />
    </div>
  </div>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .product-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .product-card__media { position: relative; aspect-ratio: 4/3; background: var(--color-surface-muted); overflow: hidden; }
  .product-card__media img { width: 100%; height: 100%; object-fit: cover; }
  .product-card__badges { position: absolute; top: 0.6rem; left: 0.6rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .product-card__actions { position: absolute; top: 0.6rem; right: 0.6rem; display: flex; flex-direction: column; gap: 0.35rem; opacity: 0; transition: opacity 0.2s; }
  .product-card:hover .product-card__actions, .product-card:focus-within .product-card__actions { opacity: 1; }
  .product-card__icon {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: rgba(255,255,255,0.95);
    color: var(--color-ink-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-xs);
    transition: color 0.15s, background 0.15s, transform 0.15s;
  }
  .product-card__icon:hover { color: var(--color-primary); background: white; transform: scale(1.05); }
  .product-card__icon[data-active='true'] { color: var(--color-amazon-ink); background: var(--color-accent); }
  .product-card__score { position: absolute; bottom: 0.6rem; right: 0.6rem; }
  .product-card__body { padding: 0.9rem 1rem 1rem; display: flex; flex-direction: column; gap: 0.55rem; flex: 1; }
  .product-card__brand { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-ink-subtle); margin: 0; }
  .product-card__title { font-family: var(--font-sans); font-size: 0.98rem; font-weight: 600; line-height: 1.35; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .product-card__title a { color: var(--color-ink); }
  .product-card__title a:hover { color: var(--color-primary); }
  .product-card__meta { display: flex; align-items: center; gap: 0.5rem; }
  .product-card__cta { margin-top: auto; }
</style>

<script>
  function refreshActive() {
    let wishlist: string[] = [];
    let compare: string[] = [];
    try { wishlist = JSON.parse(localStorage.getItem('hsg.wishlist') || '[]'); } catch {}
    try { compare = JSON.parse(localStorage.getItem('hsg.compare') || '[]'); } catch {}
    document.querySelectorAll<HTMLButtonElement>('[data-wishlist-toggle]').forEach((btn) => {
      btn.dataset.active = wishlist.includes(btn.dataset.asin || '') ? 'true' : 'false';
    });
    document.querySelectorAll<HTMLButtonElement>('[data-compare-toggle]').forEach((btn) => {
      btn.dataset.active = compare.includes(btn.dataset.asin || '') ? 'true' : 'false';
    });
  }

  function toggle(key: string, asin: string, max?: number): string[] {
    let arr: string[] = [];
    try { arr = JSON.parse(localStorage.getItem(key) || '[]'); } catch {}
    if (arr.includes(asin)) {
      arr = arr.filter((x) => x !== asin);
    } else {
      if (max && arr.length >= max) arr = arr.slice(arr.length - max + 1);
      arr.push(asin);
    }
    localStorage.setItem(key, JSON.stringify(arr));
    return arr;
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const wish = target.closest('[data-wishlist-toggle]') as HTMLButtonElement | null;
    if (wish) {
      e.preventDefault();
      toggle('hsg.wishlist', wish.dataset.asin || '');
      refreshActive();
      window.dispatchEvent(new CustomEvent('hsg:wishlist:change'));
    }
    const cmp = target.closest('[data-compare-toggle]') as HTMLButtonElement | null;
    if (cmp) {
      e.preventDefault();
      toggle('hsg.compare', cmp.dataset.asin || '', 4);
      refreshActive();
      window.dispatchEvent(new CustomEvent('hsg:compare:change'));
    }
  });

  refreshActive();
</script>
