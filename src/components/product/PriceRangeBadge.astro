---
import { PRICE_RANGES } from '../../lib/prices';
import type { PriceRange } from '../../content/config';
import { cn } from '../../lib/cn';

interface Props {
  range: PriceRange;
  variant?: 'full' | 'short';
  class?: string;
}
const { range, variant = 'full', class: className } = Astro.props;
const meta = PRICE_RANGES[range];
---

<span class={cn(
  'inline-flex items-center gap-1.5 text-[0.85rem] font-medium text-[var(--color-ink-muted)] tabular-nums',
  className,
)}>
  <span class="font-semibold text-[var(--color-ink)] tracking-wide" aria-label={meta.label}>{meta.short}</span>
  <span>{meta.label}</span>
</span>
