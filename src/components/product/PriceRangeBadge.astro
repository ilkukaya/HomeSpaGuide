---
import { PRICE_RANGES } from '../../lib/prices';
import type { PriceRange } from '../../content/config';
import { cn } from '../../lib/cn';

interface Props {
  range: PriceRange;
  variant?: 'full' | 'short';
  class?: string;
}
const { range, variant = 'full', class: className } = Astro.props;
const meta = PRICE_RANGES[range];
---

<span class={cn(
  'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-[var(--radius-sm)] border border-[var(--color-primary-200)] bg-white text-[var(--color-primary)] text-xs font-semibold uppercase tracking-wide',
  className,
)}>
  <span aria-hidden="true" class="opacity-80">{meta.short}</span>
  {variant === 'full' && <span>{meta.label}</span>}
</span>
