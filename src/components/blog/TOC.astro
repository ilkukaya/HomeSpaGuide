---
interface Heading { depth: number; slug: string; text: string }
interface Props { headings: Heading[] }
const { headings } = Astro.props;
const h2s = headings.filter((h) => h.depth === 2);
---

{h2s.length > 0 && (
  <nav class="toc" aria-label="On this page">
    <p class="toc__title">On this page</p>
    <ol>
      {h2s.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
    </ol>
  </nav>
)}

<style>
  .toc { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 1rem 1.25rem; font-size: 0.9rem; }
  .toc__title { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-ink-subtle); font-weight: 600; margin-bottom: 0.65rem; }
  .toc ol { list-style: decimal; margin: 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .toc a { color: var(--color-ink-muted); }
  .toc a:hover { color: var(--color-primary); }
</style>
